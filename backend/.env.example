# Бэкенд Task Management — пример env (для backend/docker-compose.yml)
# Скопируйте в backend/.env и при необходимости измените значения.
# Для запуска всего стека из корня используйте .env.example в корне (хост БД: postgres).

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=task_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task_db

# URL БД (хост = имя сервиса Postgres в backend/docker-compose.yml)
DATABASE_DSN=postgresql+asyncpg://task_user:change-me@postgres:5432/task_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=3600

# Приложение (порт приложения внутри контейнера — 8000)
TEMPLATE_APP_NAME=Task Management Service
TEMPLATE_APP_VERSION=0.1.0
TEMPLATE_APP_HOST=0.0.0.0
TEMPLATE_APP_PORT=8000
TEMPLATE_APP_DEBUG=false
# Имя заголовка и ключ API (для /api/v1/tasks и /api/v1/, кроме /health, /docs, /metrics)
TEMPLATE_APP_API_KEY_HEADER=X-API-KEY
TEMPLATE_APP_API_KEY=change-me

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Sentry (опционально)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
