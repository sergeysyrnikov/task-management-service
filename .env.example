# Task Management Service (.env for docker-compose)

# Приложение
TEMPLATE_APP_NAME=Task Management Service
TEMPLATE_APP_VERSION=0.1.0
TEMPLATE_APP_HOST=0.0.0.0
TEMPLATE_APP_PORT=8000
TEMPLATE_APP_DEBUG=false
# Имя заголовка и ключ API
TEMPLATE_APP_API_KEY_HEADER=X-API-KEY
TEMPLATE_APP_API_KEY=change-me

# CORS (фронтенд http://localhost:3000)
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=task_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task_db

# URL БД (внутри docker-сети)
DATABASE_DSN=postgresql+asyncpg://task_user:change-me@postgres:5432/task_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=3600

# Фронтенд (URL API с точки зрения браузера)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_KEY_HEADER=X-API-KEY
NEXT_PUBLIC_API_KEY=change-me

# Sentry (опционально)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
